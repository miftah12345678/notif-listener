<%- include('layouts/header') %>

<div class="section-header mb-24">
  <h2 class="section-title">Registered Devices</h2>
</div>

<% if (deviceStats.length > 0) { %>
<div class="app-grid">
  <% for (const d of deviceStats) { %>
    <a href="/devices/<%= d.id %>" class="device-card animate-in" id="device-card-<%= d.id %>" style="text-decoration:none">
      <div class="device-header">
        <div class="device-info">
          <div class="device-avatar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          </div>
          <div>
            <div class="device-name"><%= d.device_name %></div>
            <div class="device-model"><%= d.device_model || 'Android' %></div>
          </div>
        </div>
        <span class="badge <%= d.status === 'online' ? 'badge-success' : 'badge-neutral' %>"><%= d.status %></span>
      </div>
      <div class="device-meta">
        <div class="device-meta-item">
          <span class="device-meta-label">Active Apps</span>
          <span class="device-meta-value"><%= d.active_apps %></span>
        </div>
        <div class="device-meta-item">
          <span class="device-meta-label">Notifications</span>
          <span class="device-meta-value"><%= d.total_notifications %></span>
        </div>
        <div class="device-meta-item">
          <span class="device-meta-label">Today</span>
          <span class="device-meta-value"><%= d.today_count %></span>
        </div>
      </div>
    </a>
  <% } %>
</div>
<% } else { %>
<div class="empty-state">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
  <h3>No devices registered</h3>
  <p>Devices register automatically when the Android app connects for the first time</p>
</div>
<% } %>

<%- include('layouts/footer') %>
