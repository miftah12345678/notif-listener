<%- include('layouts/header') %>

<div class="stats-grid">
  <div class="stat-card animate-in">
    <div class="stat-label">Applications</div>
    <div class="stat-value"><%= stats.totals.total_apps %></div>
    <div class="stat-icon indigo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="9" height="9" rx="2"/><rect x="13" y="2" width="9" height="9" rx="2"/><rect x="2" y="13" width="9" height="9" rx="2"/><rect x="13" y="13" width="9" height="9" rx="2"/></svg>
    </div>
  </div>
  <div class="stat-card animate-in">
    <div class="stat-label">Active Apps</div>
    <div class="stat-value"><%= stats.totals.active_apps %></div>
    <div class="stat-icon green">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22,4 12,14.01 9,11.01"/></svg>
    </div>
  </div>
  <div class="stat-card animate-in">
    <div class="stat-label">Devices</div>
    <div class="stat-value"><%= stats.totals.total_devices %></div>
    <div class="stat-icon blue">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
    </div>
  </div>
  <div class="stat-card animate-in">
    <div class="stat-label">Notifications</div>
    <div class="stat-value"><%= stats.totals.total_notifications.toLocaleString() %></div>
    <div class="stat-icon amber">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
    </div>
  </div>
</div>

<div class="section-header">
  <h2 class="section-title">Today's Activity</h2>
</div>

<% if (stats.todayNotifs.length > 0) { %>
<div class="today-apps mb-24">
  <% for (const a of stats.todayNotifs) { %>
  <div class="today-app-item">
    <span class="today-app-name"><%= a.app_name %></span>
    <span class="today-app-count"><%= a.count %></span>
  </div>
  <% } %>
</div>
<% } else { %>
<div class="empty-state mb-24"><p>No notifications today yet</p></div>
<% } %>

<div class="section-header">
  <h2 class="section-title">Recent Notifications</h2>
  <a href="/notifications" class="btn btn-secondary btn-sm">View All</a>
</div>

<% if (stats.recent.length > 0) { %>
<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>Time</th>
        <th>App</th>
        <th>Category</th>
        <th>Title</th>
        <th>Text</th>
      </tr>
    </thead>
    <tbody>
      <% for (const n of stats.recent) { %>
      <tr onclick="window.location='/notifications/<%= n.id %>'">
        <td style="white-space:nowrap"><%= n.posted_at ? new Date(n.posted_at).toLocaleString() : '—' %></td>
        <td><span class="badge badge-primary"><%= n.app_name || n.package_name %></span></td>
        <td><span class="badge badge-neutral"><%= n.category || 'OTHER' %></span></td>
        <td class="text-truncate"><%= n.title || '—' %></td>
        <td class="text-truncate"><%= n.text || '—' %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% } else { %>
<div class="empty-state">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
  <h3>No notifications yet</h3>
  <p>Notifications from your Android devices will appear here</p>
</div>
<% } %>

<%- include('layouts/footer') %>
