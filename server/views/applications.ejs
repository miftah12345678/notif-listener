<%- include('layouts/header') %>

<div class="section-header">
  <h2 class="section-title">Application Catalog</h2>
  <button class="btn btn-primary" onclick="openAddAppModal()" id="btn-add-app">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Add Application
  </button>
</div>

<% if (apps.length > 0) { %>
<div class="app-grid">
  <% for (const a of appStats) { %>
    <div class="app-card animate-in" id="app-card-<%= a.id %>">
      <div class="app-card-header">
        <div class="app-card-info">
          <div class="app-avatar"><%= (a.app_name || '?')[0].toUpperCase() %></div>
          <div>
            <div class="app-card-name"><%= a.app_name %></div>
            <div class="app-card-package"><%= a.package_name %></div>
          </div>
        </div>
        <div class="flex gap-8">
          <button class="btn btn-secondary btn-sm" onclick="editApp('<%= a.id %>', '<%= a.app_name %>')" title="Edit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </button>
          <button class="btn btn-danger btn-sm" onclick="deleteApp('<%= a.id %>', '<%= a.app_name %>')" title="Delete">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="3,6 5,6 21,6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>
      </div>
      <div class="app-card-stats">
        <div class="app-card-stat">
          <span class="app-card-stat-label">Notifications</span>
          <span class="app-card-stat-value"><%= a.notification_count %></span>
        </div>
        <div class="app-card-stat">
          <span class="app-card-stat-label">Active Devices</span>
          <span class="app-card-stat-value"><%= a.active_devices %></span>
        </div>
      </div>
    </div>
  <% } %>
</div>
<% } else { %>
<div class="empty-state">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="9" height="9" rx="2"/><rect x="13" y="2" width="9" height="9" rx="2"/><rect x="2" y="13" width="9" height="9" rx="2"/><rect x="13" y="13" width="9" height="9" rx="2"/></svg>
  <h3>No applications registered</h3>
  <p>Applications will be auto-registered when devices send notifications, or you can add them manually</p>
</div>
<% } %>

<!-- Add App Modal -->
<div class="modal-backdrop" id="add-app-modal">
  <div class="modal">
    <h3 class="modal-title">Add Application</h3>
    <form id="add-app-form">
      <div class="form-group">
        <label class="form-label" for="app-package">Package Name</label>
        <input type="text" id="app-package" class="form-input" placeholder="e.g. id.dana" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="app-name">Application Name</label>
        <input type="text" id="app-name" class="form-input" placeholder="e.g. DANA" required>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closeModal('add-app-modal')">Cancel</button>
        <button type="submit" class="btn btn-primary">Add Application</button>
      </div>
    </form>
  </div>
</div>

<%- include('layouts/footer') %>
